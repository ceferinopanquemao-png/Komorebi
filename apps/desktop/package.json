{
  "name": "komorebi-journal",
  "version": "1.0.0",
  "description": "A quiet, encrypted daily journal inspired by Hobonichi and Typora",
  "author": "Komorebi",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "desktop": "npm run build && electron .",
    "build": "vite build",
    "test": "node --test test/*.test.cjs",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "dist:windows": "npm run build && electron-builder --win nsis",
    "pack": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "lucide": "^0.468.0",
    "marked": "^15.0.7",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.0.12",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "app.komorebi.journal",
    "productName": "Komorebi",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
